# Mẫu biến môi trường. Copy thành .env.local rồi điền giá trị thật:
#   cp app/be/.env.example app/be/.env.local
# File .env.local KHÔNG được commit (đã nằm trong .gitignore).

# Cổng app lắng nghe. Trên App Service phải khớp app setting WEBSITES_PORT.
PORT=8080

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=opsboard
DB_USER=root
DB_PASSWORD=
# Local container không bật TLS → false.
# Trên Azure MySQL Flexible bắt buộc TLS → true.
DB_TLS=false

# Giới hạn cho /load?seconds=n, chặn việc đốt CPU quá lâu (1..=300)
LOAD_MAX_SECONDS=60
# Số request /load chạy đồng thời tối đa trên một instance (1..=16, mặc định 4); vượt → 429
# LOAD_MAX_CONCURRENT=4

# Development luôn bật Swagger UI (/swagger). Giữ Production trên Azure;
# muốn bật riêng Swagger khi demo thì đặt SWAGGER_ENABLED=true.
# SWAGGER_ENABLED=false
ASPNETCORE_ENVIRONMENT=Development
