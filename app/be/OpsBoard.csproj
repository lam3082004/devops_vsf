<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>OpsBoard</RootNamespace>
    <AssemblyName>OpsBoard</AssemblyName>
    <!-- SHA của commit, truyền lúc build qua dotnet publish -p:GitSha=<sha ngắn>.
         Không truyền thì mặc định "dev" (xem Target EmbedGitSha bên dưới). -->
    <GitSha Condition="'$(GitSha)' == ''">dev</GitSha>
    <!-- Bật XML doc để Swagger (IncludeXmlComments) đọc được summary của action/DTO.
         Hệ quả: CS1591 (thiếu XML comment) nổ trên toàn bộ member public sẵn có.
         make lint/CI chạy dotnet format (verify no changes, severity warn) + build
         Release nên phải tắt CS1591 tường minh ở đây, thay vì đi viết doc cho từng
         member public chỉ để phục vụ việc bật Swagger, ngoài phạm vi việc này. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <!--
    Sinh một file .cs chứa hằng số GitSha TRƯỚC khi compile — tương đương build.rs
    của bản Rust (option_env!("GIT_SHA")). Nhúng cứng lúc build, không đọc biến
    môi trường lúc chạy: mục tiêu là SHA không thể bị set nhầm/giả lúc runtime.
    %3B / &quot; là ký tự thoát bắt buộc vì tham số Lines của WriteLinesToFile
    tách chuỗi theo dấu ';' như một danh sách item của MSBuild.
  -->
  <Target Name="EmbedGitSha" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <GitShaSourceFile>$(IntermediateOutputPath)GitSha.g.cs</GitShaSourceFile>
    </PropertyGroup>
    <ItemGroup>
      <Compile Include="$(GitShaSourceFile)" />
    </ItemGroup>
    <WriteLinesToFile File="$(GitShaSourceFile)" Lines="namespace OpsBoard%3B internal static class BuildInfo { public const string GitSha = &quot;$(GitSha)&quot;%3B }" Overwrite="true" />
  </Target>

</Project>
