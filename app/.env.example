# Mẫu biến môi trường. Copy thành .env.local rồi điền giá trị thật:
#   cp app/.env.example app/.env.local
# File .env.local KHÔNG được commit (đã nằm trong .gitignore).

# Cổng app lắng nghe. Trên App Service phải khớp app setting WEBSITES_PORT.
PORT=8080

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=nodereg
DB_USER=root
DB_PASSWORD=
# Local container không bật TLS → false.
# Trên Azure MySQL Flexible bắt buộc TLS → true.
DB_TLS=false

# Giới hạn cho /load?seconds=n, chặn việc đốt CPU quá lâu (1..=300)
LOAD_MAX_SECONDS=60

# Bật Swagger UI (/swagger) để xem thử API — chỉ dev, không đặt biến này
# trên Azure thật (Terraform không set nó, mặc định Production → Swagger tắt).
ASPNETCORE_ENVIRONMENT=Development
